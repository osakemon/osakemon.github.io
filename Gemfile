source 'https://rubygems.org'

group :jekyll_plugins do
    gem 'jekyll'
    gem 'jekyll-email-protect'   # `encode_email` filter, used in _includes/social.html
    gem 'jekyll-imagemagick'     # responsive webp variants for assets/img
    gem 'jekyll-link-attributes' # adds target/rel to external links
    gem 'jekyll-minifier'
    gem 'jekyll-scholar'         # renders _bibliography/papers.bib
    gem 'jekyll-sitemap'
    gem 'jemoji'                 # `emojify` filter, used in _includes/news.html
    gem 'mini_racer'             # JS runtime required by jekyll-minifier
    gem 'unicode_utils'          # required by jekyll-scholar's smallcaps filter
    gem 'webrick'                # required by `jekyll serve` on Ruby 3+
end
